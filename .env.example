# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# None of these may use the NEXT_PUBLIC_ prefix: that would ship them to the browser.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Flash-tier model id. "gemini-flash-latest" always points at the newest one.
GEMINI_MODEL=gemini-flash-latest
