# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# None of these may use the NEXT_PUBLIC_ prefix: that would ship them to the browser.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Trusted models, comma-separated, tried in order. If the first is overloaded,
# out of quota or retired, the next one is used. Pinned versions are steadier
# than "gemini-flash-latest" but are retired eventually, so expect to update this.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash
# Backup models, used only when every trusted model is out of quota. Their
# results are marked provisional and redone once a trusted model is back.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Free-tier limits per model. Raise these if you enable billing.
GEMINI_DAILY_LIMIT=20
GEMINI_RPM=5

# Supabase (Project Settings > API). Leave both empty to use local JSON files
# under .data/ instead. The service-role key bypasses Row Level Security: it
# must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel Cron sends it as "Authorization: Bearer ...",
# and /api/cron/ingest refuses requests without it.
CRON_SECRET=


# Set to 1 to show event and reward images loaded from Nexon's servers. They are
# Nexon's copyrighted material and no fan-site licence was found, so decide
# deliberately before turning this on for a public site.
NEXON_IMAGES=

# The site's public address, used in the sitemap and share previews. On Vercel
# it can stay empty: the production domain is picked up automatically.
SITE_URL=
