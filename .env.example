# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# None of these may use the NEXT_PUBLIC_ prefix: that would ship them to the browser.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated model ids, tried in order. If the first is overloaded, rate
# limited or retired, the next one is used. Pinned versions are steadier than
# "gemini-flash-latest" but are retired eventually, so expect to update this.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite

# Set to 1 to serve the saved sample in lib/fixtures instead of calling Gemini.
# Use it for UI work; leave it off to classify live posts.
TRACKER_FIXTURE=

# Set to 1 to show event and reward images loaded from Nexon's servers. They are
# Nexon's copyrighted material and no fan-site licence was found, so decide
# deliberately before turning this on for a public site.
NEXON_IMAGES=
